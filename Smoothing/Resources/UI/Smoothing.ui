     </property>
     <layout class="QFormLayout" name="outputsFormLayout">

      <item row="0" column="0">
       <widget class="QLabel" name="overwriteInputLabel">
        <property name="text">
         <string>Overwrite input:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="overwriteInputCheckBox">
        <property name="toolTip">
