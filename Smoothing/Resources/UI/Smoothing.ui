<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Smoothing</class>
 <widget class="qMRMLWidget" name="Smoothing">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>430</width>
    <height>650</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">

   <item>
    <widget class="ctkCollapsibleButton" name="inputsCollapsibleButton">
     <property name="text">
      <string>Inputs</string>
     </property>
     <layout class="QFormLayout" name="inputsFormLayout">

      <item row="0" column="0">
       <widget class="QLabel" name="inputSegmentationLabel">
        <property name="text">
         <string>Input segmentation:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="qMRMLNodeComboBox" name="inputSegmentationSelector">
        <property name="toolTip">
         <string>Select the segmentation to smooth.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLSegmentationNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>false</bool>
        </property>
        <property name="removeEnabled">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>inputSegmentation</string>
        </property>
       </widget>
      </item>

      <item row="1" column="0">
       <widget class="QLabel" name="referenceVolumeLabel">
        <property name="text">
         <string>Reference volume:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="qMRMLNodeComboBox" name="referenceVolumeSelector">
        <property name="toolTip">
         <string>Select the reference volume associated with the segmentation.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLScalarVolumeNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>false</bool>
        </property>
        <property name="removeEnabled">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>referenceVolume</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <item>
    <widget class="ctkCollapsibleButton" name="methodsCollapsibleButton">
     <property name="text">
      <string>Smoothing methods</string>
     </property>
     <layout class="QVBoxLayout" name="methodsVerticalLayout">

      <item>
       <widget class="QLabel" name="methodsDescriptionLabel">
        <property name="text">
         <string>Select one or more smoothing methods. Selected methods are applied sequentially in the order shown below.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>

      <item>
       <layout class="QGridLayout" name="methodsGridLayout">

        <item row="0" column="0">
         <widget class="QCheckBox" name="medianCheckBox">
          <property name="text">
           <string>Median</string>
          </property>
          <property name="toolTip">
           <string>Removes small irregularities while preserving the general segmentation boundary.</string>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>medianEnabled</string>
          </property>
         </widget>
        </item>

        <item row="0" column="1">
         <widget class="QCheckBox" name="openingCheckBox">
          <property name="text">
           <string>Opening</string>
          </property>
          <property name="toolTip">
           <string>Removes small protrusions from the segmentation.</string>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>openingEnabled</string>
          </property>
         </widget>
        </item>

        <item row="1" column="0">
         <widget class="QCheckBox" name="closingCheckBox">
          <property name="text">
           <string>Closing</string>
          </property>
          <property name="toolTip">
           <string>Fills small holes and narrow gaps in the segmentation.</string>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>closingEnabled</string>
          </property>
         </widget>
        </item>

        <item row="1" column="1">
         <widget class="QCheckBox" name="gaussianCheckBox">
          <property name="text">
           <string>Gaussian</string>
          </property>
          <property name="toolTip">
           <string>Applies Gaussian smoothing to the segmentation boundary.</string>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>gaussianEnabled</string>
          </property>
         </widget>
        </item>

        <item row="2" column="0">
         <widget class="QCheckBox" name="jointTaubinCheckBox">
          <property name="text">
           <string>Joint Taubin</string>
          </property>
          <property name="toolTip">
           <string>Smooths visible segments jointly and helps preserve interfaces between segments.</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>jointTaubinEnabled</string>
          </property>
         </widget>
        </item>

       </layout>
      </item>

     </layout>
    </widget>
   </item>

   <item>
    <widget class="ctkCollapsibleButton" name="parametersCollapsibleButton">
     <property name="text">
      <string>Smoothing parameters</string>
     </property>
     <layout class="QVBoxLayout" name="parametersVerticalLayout">

      <item>
       <widget class="QTabWidget" name="parametersTabWidget">
