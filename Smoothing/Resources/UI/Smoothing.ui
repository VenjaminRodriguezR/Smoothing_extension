       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="scopeComboBox">
        <property name="toolTip">
         <string>Select whether smoothing is applied to visible segments or all segments.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>applyScope</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
