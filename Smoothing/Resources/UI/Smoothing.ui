          <item row="0" column="0">
           <widget class="QLabel" name="closingKernelSizeLabel">
            <property name="text">
             <string>Kernel size:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="ctkSliderWidget" name="closingKernelSizeSliderWidget">
            <property name="toolTip">
             <string>Closing kernel size in millimeters.</string>
            </property>
            <property name="minimum">
