 <resources/>

 <connections>
  <connection>
   <sender>Smoothing</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>inputSegmentationSelector</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>100</x>
     <y>50</y>
    </hint>
    <hint type="destinationlabel">
     <x>300</x>
     <y>50</y>
    </hint>
   </hints>
  </connection>

  <connection>
   <sender>Smoothing</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>referenceVolumeSelector</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>100</x>
     <y>80</y>
    </hint>
    <hint type="destinationlabel">
     <x>300</x>
     <y>80</y>
    </hint>
   </hints>
  </connection>

  <connection>
   <sender>Smoothing</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>outputSegmentationSelector</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>100</x>
     <y>530</y>
    </hint>
    <hint type="destinationlabel">
     <x>300</x>
     <y>530</y>
