   <item>
    <widget class="ctkCollapsibleButton" name="scopeCollapsibleButton">
     <property name="text">
      <string>Application scope</string>
     </property>
     <layout class="QFormLayout" name="scopeFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="scopeLabel">
